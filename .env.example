# ============================================================
# CampusGig Backend — Environment Variables Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# Add .env to .gitignore!
# ============================================================

# ── Required ─────────────────────────────────────────────────

# The port the server listens on
PORT=5000

# Node environment (development | production | test)
NODE_ENV=development

# MongoDB connection string
# Local dev:      mongodb://localhost:27017/campus_gig
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/campus_gig
MONGODB_URI=mongodb://localhost:27017/campus_gig

# JWT secret — MUST be at least 32 random characters in production
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# URL of your web/mobile client (used for CORS allow-list)
CLIENT_URL=http://localhost:3000

# ── Optional: Logging ──────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production
LOG_LEVEL=info

# ── Optional: Redis (Socket.IO Horizontal Scaling) ────────
# Required when running multiple server instances (PM2 cluster,
# Kubernetes, AWS ECS etc.). Without this, Socket.IO uses
# in-memory state which is isolated per process.
#
# Format: redis://:<password>@<host>:<port>
# Upstash: rediss://:<token>@<host>:<port>
#
# Leave blank for single-server / local development.
# REDIS_URL=redis://localhost:6379

# ── Optional: Cloudinary (Cloud Avatar Storage) ───────────
# Required for persistent avatar uploads across container restarts
# and multi-instance deployments. Without this, avatars are saved
# to the local /uploads folder (lost on container restarts).
#
# Get your URL from: https://cloudinary.com/console
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Leave blank to use local disk storage (development only).
# CLOUDINARY_URL=cloudinary://123456789:abcdefghijklmn@my-cloud-name

# ── Optional: Google OAuth ─────────────────────────────────
# Required to verify Google Sign-In ID tokens from the Android app.
# Without this, the /api/auth/google endpoint will return 503.
#
# Get the Web application Client ID from Google Cloud/Firebase. It must match
# the Android app's requested ID-token audience and the backend's setting.
#
# GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# ── Optional: Email (Forgot Password OTP) ─────────────────
# Required to send OTP emails for the forgot-password feature.
# Use a Gmail account with an App Password (NOT your real password).
#
# Enable 2-Step Verification on your Google account first, then generate
# an App Password at: https://myaccount.google.com/apppasswords
#
# Without this, the server rejects forgot-password requests instead of claiming
# that an email was sent. This must be set in production.
#
# EMAIL_USER=your.gmail@gmail.com
# EMAIL_PASS=abcd-efgh-ijkl-mnop   ← 16-character app password from Google
# EMAIL_FROM="CampusVault <CampusVault.co@gmail.com>"

# ── Optional: Firebase Cloud Messaging (FCM Push Notifications) ─────
# Required to send push notifications to mobile devices when app is backgrounded.
#
# Option A: Paste full JSON string of your Firebase serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
#
# Option B: Put path to serviceAccountKey.json file
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
